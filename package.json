{
  "name": "supplysense",
  "version": "1.0.0",
  "private": true,
  "description": "SupplySense — Autonomous AI Supply Chain Operating System",
  "scripts": {
    "dev": "concurrently --kill-others --names \"API,WEB\" --prefix-colors \"yellow,cyan\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "cd frontend && pnpm dev",
    "dev:backend": "node scripts/dev-backend.js",
    "dev:turbo": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "clean": "turbo clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "setup": "node scripts/setup.js",
    "setup:frontend": "node scripts/setup.js --frontend-only",
    "setup:backend": "node scripts/setup.js --backend-only",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @supplysense/api db:migrate",
    "db:seed": "pnpm --filter @supplysense/api db:seed"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "prettier": "^3.2.5",
    "turbo": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "packageManager": "pnpm@9.1.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "workspaces": [
    "frontend",
    "backend",
    "packages/*"
  ]
}
