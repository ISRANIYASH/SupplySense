# ==============================================================
# SupplySense Environment Variables
# Copy this file to .env and fill in your values
# ==============================================================

# ── Neon / PostgreSQL (required) ──────────────────────────────────────────────
# When using Neon or a cloud PostgreSQL provider:
# DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
# Or configure individual parameters for local development:
POSTGRES_USER=supplysense_admin
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=supplysense

# ── Email Alerts (optional) ───────────────────────────────────────────────────
EMAIL_SENDER=
EMAIL_PASSWORD=
EMAIL_RECIPIENT=
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587

# ── Market Intelligence (optional) ───────────────────────────────────────────
MARKET_CHECK_INTERVAL_MINUTES=15
PRICE_BUY_SIGNAL_PERCENTILE=25
PRICE_STRONG_BUY_PERCENTILE=10

# ── MLflow (optional — local SQLite by default) ──────────────────────────────
MLFLOW_TRACKING_URI=sqlite:///mlruns/mlflow.db

# ── Authentication (NextAuth) ─────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here_at_least_32_characters
# In local: http://localhost:3000
# In Vercel production: https://supply-sense-eta-six.vercel.app
NEXTAUTH_URL=http://localhost:3000

# ── Google OAuth 2.0 (Google Cloud Console) ───────────────────────────────────
# Authorized JavaScript Origin: http://localhost:3000 (local) and https://supply-sense-eta-six.vercel.app (prod)
# Authorized Redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Production Deployment (set when deploying) ────────────────────────────────
# FRONTEND_URL=https://supply-sense-eta-six.vercel.app
# NEXT_PUBLIC_API_URL=https://supplysense-09a0.onrender.com
